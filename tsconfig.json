
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./*.tsx",
    "./*.ts",
    "./types.ts",
    "./constants.ts",
    "./contexts/**/*.ts",
    "./contexts/**/*.tsx",
    "./components/**/*.ts",
    "./components/**/*.tsx",
    "./hooks/**/*.ts",
    "./hooks/**/*.tsx",
    "./pages/**/*.ts",
    "./pages/**/*.tsx",
    "./services/**/*.ts",
    "./services/**/*.tsx",
    "./locales/**/*.json"
  ],
  "exclude": ["src", "node_modules", "dist"]
}
